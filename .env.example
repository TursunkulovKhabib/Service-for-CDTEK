# --- Django ---------------------------------------------------------------- #
DJANGO_ENV=dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost;127.0.0.1
DJANGO_TIME_ZONE=Europe/Moscow
DJANGO_LOG_LEVEL=INFO

# --- PostgreSQL (DB_ENGINE=sqlite - локальная разработка без БД) ------------- #
DB_ENGINE=postgres
POSTGRES_DB=contacts
POSTGRES_USER=contacts
POSTGRES_PASSWORD=contacts
POSTGRES_HOST=127.0.0.1
# 5433 - порт, который отдаёт наружу контейнер из docker-compose.yml
POSTGRES_PORT=5433

# --- API v1 (Старая версия) ------------------------------ #
LEGACY_V1_REQUIRE_BASIC_AUTH=0
LEGACY_V1_ENVELOPE=
LEGACY_V1_SEARCH_PARAM=query
LEGACY_V1_DEPARTMENT_PARAM=department
LEGACY_V1_COMPANY_PARAM=company
LEGACY_V1_LIMIT_PARAM=limit

# --- API v2 (JWT) ------------------------------------------------------------ #
API_V2_REQUIRE_JWT=1
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
API_PAGE_SIZE=50

# --- Организация 1: ЦЦ ТЭК ----------------------------------------------------------- #
COMPANY_DEFAULT_CODE=cdtek
LDAP_CDTEK_SERVER_URI=ldaps://dc01.corp.local
LDAP_CDTEK_PORT=636
LDAP_CDTEK_USE_SSL=1
LDAP_CDTEK_TLS_VALIDATE=1
LDAP_CDTEK_CA_CERTS_FILE=/etc/ssl/certs/corp-root-ca.pem
LDAP_CDTEK_BIND_DN=CN=svc-contacts,OU=Service,DC=corp,DC=local
LDAP_CDTEK_BIND_PASSWORD=
LDAP_CDTEK_BASE_DN=DC=corp,DC=local
LDAP_CDTEK_SEARCH_OUS=OU=Users,OU=Company,DC=corp,DC=local
# Порядок даты рождения в extensionAttribute1. Пусто - подбирается сам
# (ЦЦ ТЭК хранит MM.dd.yyyy, ЭНГС - yyyy-MM-dd, оба разбираются без настройки).
LDAP_CDTEK_BIRTHDAY_FORMAT=

# --- Организация 2: ЭНГС ----------------------------------------------------------- #
COMPANY_ENGS_ENABLED=0
LDAP_ENGS_SERVER_URI=ldaps://dc02.branch.local
LDAP_ENGS_PORT=636
LDAP_ENGS_USE_SSL=1
LDAP_ENGS_TLS_VALIDATE=1
LDAP_ENGS_BIND_DN=CN=svc-contacts,OU=Service,DC=branch,DC=local
LDAP_ENGS_BIND_PASSWORD=
LDAP_ENGS_BASE_DN=DC=branch,DC=local
LDAP_ENGS_SEARCH_OUS=OU=Users,OU=Company,DC=branch,DC=local

# --- Синхронизация ----------------------------------------------------------- #
LDAP_PAGE_SIZE=500
LDAP_TIMEOUT=30
LDAP_DEACTIVATE_MISSING=1
LDAP_MIN_ENTRIES_FOR_DEACTIVATION=10
LDAP_SYNC_INCREMENTAL_MINUTES=15
LDAP_SYNC_FULL_CRON=20 3 * * *
LDAP_INCREMENTAL_OVERLAP_MINUTES=10

# --- Celery ------------------------------------------------------------------ #
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=django-db
