# --- Django ---------------------------------------------------------------- #
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost;127.0.0.1
DJANGO_TIME_ZONE=Europe/Moscow
DJANGO_LOG_LEVEL=INFO

# --- PostgreSQL (DB_ENGINE=sqlite - локальная разработка без БД) ------------- #
DB_ENGINE=postgres
POSTGRES_DB=contacts
POSTGRES_USER=contacts
POSTGRES_PASSWORD=contacts
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Active Directory ------------------------------------------------------- #
# Профиль каталога: ad (боевой AD) или openldap (демо-сервер для смоук-теста)
LDAP_PROFILE=ad
LDAP_SERVER_URI=ldaps://dc01.corp.local
LDAP_PORT=636
LDAP_USE_SSL=1
LDAP_START_TLS=0
LDAP_TLS_VALIDATE=1
LDAP_CA_CERTS_FILE=/etc/ssl/certs/corp-root-ca.pem
# Сервисная учётка с правом чтения каталога (пароль только в окружении!)
LDAP_BIND_DN=CN=svc-contacts,OU=Service,DC=corp,DC=local
LDAP_BIND_PASSWORD=
LDAP_AUTHENTICATION=SIMPLE
LDAP_BASE_DN=DC=corp,DC=local
# Несколько OU перечисляются через ';'
LDAP_SEARCH_OUS=OU=Users,OU=Company,DC=corp,DC=local;OU=Users,OU=Branch,DC=corp,DC=local
# Пусто - берётся фильтр профиля (person + user, без компьютеров)
LDAP_USER_FILTER=
LDAP_INCLUDE_DISABLED=0
LDAP_PAGE_SIZE=500
LDAP_TIMEOUT=30
LDAP_RECEIVE_TIMEOUT=60
LDAP_DEACTIVATE_MISSING=1
# Страховка от пустой выдачи: не деактивировать всех, если пришло меньше N записей
LDAP_MIN_ENTRIES_FOR_DEACTIVATION=10

# --- API для бота "Контакты" (MAX/TG) --------------------------------------- #
API_KEY=
API_REQUIRE_KEY=1
API_PAGE_SIZE=50

# --- Celery ----------------------------------------------------------------- #
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
LDAP_SYNC_INCREMENTAL_MINUTES=15
LDAP_SYNC_FULL_CRON=20 3 * * *
